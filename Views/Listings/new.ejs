<%- layout("/layouts/boilerplate") %>

    <h3>Add a New Listing</h3>

    <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="row">
            <div class="col-8 offset-2">

                <!-- Title -->
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" id="title" placeholder="Enter Title" class="form-control"
                        required>
                    <div class="invalid-feedback">Title is required</div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" id="description" placeholder="Enter Description"
                        class="form-control" required></textarea>
                    <div class="invalid-feedback">Description is required</div>
                </div>

                <!-- Image -->
                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input type="file" name="listing[image]" id="image" class="form-control">
                </div>

                <!-- Price + Country -->
                <div class="row">

                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" name="listing[price]" id="price" placeholder="Enter Price"
                            class="form-control" required>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" name="listing[country]" id="country" placeholder="Enter Country"
                            class="form-control" required>
                        <div class="invalid-feedback">Country is required</div>
                    </div>

                </div>

                <!-- Location -->
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" name="listing[location]" id="location" placeholder="Enter Location"
                        class="form-control" required>
                    <div class="invalid-feedback">Location is required</div>
                </div>

                <!-- Categories -->
                <div class="mb-3">

                    <label class="form-label"><strong>Categories</strong></label>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Trending">
                        <label class="form-check-label">Trending</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Rooms">
                        <label class="form-check-label">Rooms</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]"
                            value="Iconic Cities">
                        <label class="form-check-label">Iconic Cities</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Mountains">
                        <label class="form-check-label">Mountains</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Forts">
                        <label class="form-check-label">Forts</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Pools">
                        <label class="form-check-label">Pools</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Farms">
                        <label class="form-check-label">Farms</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Camping">
                        <label class="form-check-label">Camping</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Snowfall">
                        <label class="form-check-label">Snowfall</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="listing[category][]" value="Beach">
                        <label class="form-check-label">Beach</label>
                    </div>

                </div>

                <button class="btn btn-warning">Add to the Database</button>

            </div>
        </div>

    </form>