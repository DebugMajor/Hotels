<% layout("Layouts/boilerplate") %>

    <style>
        .page-content {
            max-width: 1100px;
        }

        .listing-card {
            border: none;
            border-radius: 16px;
            overflow: hidden;
        }

        .listing-card img {
            height: 260px;
            object-fit: cover;
        }

        .listing-info {
            font-size: 0.95rem;
            color: #555;
        }

        .price {
            font-size: 1.1rem;
            font-weight: 600;
        }

        .owner {
            font-size: 0.9rem;
            color: #666;
        }

        .review-card {
            border: none;
            border-radius: 12px;
            background: #fafafa;
        }

        #map {
            height: 420px;
            width: 100%;
            border-radius: 14px;
        }

        .section-card {
            border: none;
            border-radius: 16px;
        }

        .btn-edit {
            border-radius: 25px;
        }

        .btn-delete {
            border-radius: 25px;
        }
    </style>


    <div class="page-content container my-5">

        <h2 class="fw-semibold mb-4">
            <%= listing.title %>
        </h2>


        <div class="card listing-card shadow-sm mb-5" style="max-width:520px;">

            <img src="<%= listing.image.url ? listing.image.url : listing.image %>" class="card-img-top">

            <div class="card-body">

                <p class="owner">
                    Owned by <strong>
                        <%= listing.owner.username %>
                    </strong>
                </p>

                <p class="listing-info">
                    <%= listing.description %>
                </p>

            </div>

            <ul class="list-group list-group-flush">

                <li class="list-group-item price">
                    ₹ <%= listing.price.toLocaleString("en-IN") %> / night
                </li>

                <li class="list-group-item">
                    <strong>Location:</strong>
                    <%= listing.location %>
                </li>

                <li class="list-group-item">
                    <strong>Country:</strong>
                    <%= listing.country %>
                </li>

            </ul>


            <% if(currUser && currUser._id.equals(listing.owner._id)) { %>

                <div class="card-body d-flex gap-2">

                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-edit">
                        Edit
                    </a>

                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-danger btn-delete">
                            Delete
                        </button>
                    </form>

                </div>

                <% } %>

        </div>



        <% if(currUser){ %>

            <div class="card section-card shadow-sm mb-5 p-4">

                <h4 class="fw-semibold mb-3">Leave a Review</h4>

                <form action="/listings/<%= listing._id %>/reviews" method="POST">

                    <textarea name="review[comment]" rows="4" class="form-control mb-3" required></textarea>

                    <button class="btn btn-dark rounded-pill px-4">
                        Submit Review
                    </button>

                </form>

            </div>

            <% } %>



                <% if(listing.reviews.length> 0){ %>

                    <div class="card section-card shadow-sm p-4 mb-5">

                        <h4 class="fw-semibold mb-4">Guest Reviews</h4>

                        <% listing.reviews.forEach(review=> { %>

                            <div class="card review-card shadow-sm mb-3">

                                <div class="card-body">

                                    <h6 class="fw-semibold">
                                        <%= review.author.username %>
                                    </h6>

                                    <p>
                                        <%= review.comment %>
                                    </p>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>



                        <div class="card section-card shadow-sm p-4">

                            <h4 class="fw-semibold mb-3">Where you'll be</h4>

                            <div id="map"></div>

                        </div>

    </div>


    <!-- VARIABLES FOR MAP -->
    <script>
        const mapToken = "<%= mapToken %>";
        const listing = <%- JSON.stringify(listing) %>;
    </script>

    <!-- MAP SCRIPT -->
    <script src="/js/map.js"></script>