<% layout("/Layouts/boilerplate") %>

    <% if (typeof success !=='undefined' && success.length> 0) { %>
        <div class="alert alert-success">
            <%= success[0] %>
        </div>
        <% } %>

            <style>
                #filters {
                    display: flex;
                    gap: 2rem;
                    margin-top: 1rem;
                    overflow-x: auto;
                    align-items: center;
                    padding-bottom: 0.5rem;
                }

                .filter {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    cursor: pointer;
                    text-decoration: none;
                    opacity: 0.7;
                    color: #121111;
                }

                .filter i {
                    font-size: 1.3rem;
                }

                @media(max-width: 768px) {
                    .filter i {
                        font-size: 1.1 rem;
                    }

                    .filter p {
                        font-size: 0.75 rem;
                    }
                }

                .filter:hover {
                    opacity: 1;
                    cursor: pointer;
                }



                .filter p {
                    margin: 0;
                    font-size: 0.9rem;
                }

                .tax-info {
                    display: none;
                }

                .tax-toggle {
                    display: flex;
                    align-items: center;
                    gap: 0.8rem;

                    margin-left: 2rem;

                    padding: 0.5rem 1rem;

                    border: 1.5px solid #e5e5e5;
                    border-radius: 999px;

                    background: #f7f7f7;

                    font-size: 0.9rem;
                    font-weight: 500;

                    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);

                    transition: all 0.2s ease;
                }

                .toggle-switch {
                    width: 40px;
                    height: 20px;
                    cursor: pointer;
                }

                .tax-toggle:hover {
                    background: #fff;
                    border-color: #ccc;
                    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
                }

                .tax-toggle input {
                    cursor: pointer;
                    transform: scale(1.2);
                }

                .toggle-label {
                    margin: 0;
                    cursor: pointer;
                }
            </style>


            <h3>All Listings</h3> <br>
            <div id="filters">
                <a href="/listings/filter/Trending" class="filter filter-trending">
                    <div><i class="fa-solid fa-fire"></i></div>
                    <p>Trending</p>
                </a>

                <a href="/listings/filter/Rooms" class="filter">
                    <div><i class="fa-solid fa-bed"></i></div>
                    <p>Rooms</p>
                </a>

                <a href="/listings/filter/Mountains" class="filter">
                    <div><i class="fa-solid fa-mountain-city"></i></div>
                    <p>Mountains</p>
                </a>
                <a href="/listings/filter/Forts" class="filter">
                    <div><i class="fa-brands fa-fort-awesome"></i></div>
                    <p>Forts</p>
                </a>
                <a href="/listings/filter/Pools" class="filter">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p>Pools</p>
                </a>
                <a href="/listings/filter/Farms" class="filter">
                    <div><i class="fa-solid fa-cow"></i></div>
                    <p>Farms</p>
                </a>
                <a href="/listings/filter/Camping" class="filter">
                    <div><i class="fa-solid fa-campground"></i></div>
                    <p>Camping</p>
                </a>
                <a href="/listings/filter/Snowfall" class="filter">
                    <div><i class="fa-solid fa-snowflake"></i></i></div>
                    <p>Snowfall</p>
                </a>
                <a href="/listings/filter/Beach" class="filter">
                    <div><i class="fa-solid fa-umbrella-beach"></i></div>
                    <p>Beach</p>
                </a>
                <a href="/listings/filter/Domes" class="filter">
                    <div><i class="fa-solid fa-landmark-dome"></i></div>
                    <p>Domes</p>
                </a>
                <a href="/listings/filter/Boats" class="filter">
                    <div><i class="fa-solid fa-sailboat"></i></div>
                    <p>Boats</p>
                </a>
                <a href="/listings/filter/Zoo" class="filter">
                    <div><i class="fa-solid fa-otter"></i></i></div>
                    <p>Zoo</p>
                </a>
                <div class="tax-toggle">
                    <span>Display total after Taxes</span>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" id="switchCheckDefault">
                    </div>
                </div>

            </div>

            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-xs-1 mt-3">
                <% for (let listing of allListing) { %>
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="card col listing-card" style="width: 20rem;">
                            <img src="<%= listing.image.url ? listing.image.url : listing.image %>" class="card-img-top"
                                alt="listing_image" style="height:20rem;" />
                            <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= listing.title %>
                                </h5>
                                <p class="card-text">
                                    <%= listing.description %>
                                </p>
                                <p class="price">
                                    <strong>Price:</strong>
                                    ₹<span class="price-value" data-price="<%= listing.price %>">
                                        <%= listing.price.toLocaleString("en-IN") %>
                                    </span>
                                    /Night
                                    <i class="tax-info">&nbsp;+18% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                    <% } %>
            </div>


            <script>
                let taxSwitch = document.getElementById("switchCheckDefault");

                taxSwitch.addEventListener("click", () => {

                    let prices = document.querySelectorAll(".price-value");
                    let taxInfo = document.getElementsByClassName("tax-info");

                    prices.forEach(priceElement => {

                        let basePrice = Number(priceElement.dataset.price);

                        if (taxSwitch.checked) {

                            let taxAmount = basePrice * 0.18;
                            let taxPrice = basePrice + taxAmount;

                            priceElement.innerText = basePrice.toLocaleString("en-IN");

                            priceElement.nextElementSibling.innerText =
                                ` + ₹${Math.round(taxAmount)} GST = ₹${Math.round(taxPrice)}`;

                        } else {
                            priceElement.innerText = basePrice.toLocaleString("en-IN");
                        }
                    });
                    for (let info of taxInfo) {
                        info.style.display = taxSwitch.checked ? "inline" : "none";
                    }
                });
            </script>